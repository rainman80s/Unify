{
  "name": "unify-desktop",
  "productName": "Unify.js",
  "version": "0.1.0",
  "private": true,
  "description": "Unify.js Mac app",
  "main": "main.mjs",
  "scripts": {
    "postinstall": "node ensure-electron.mjs && electron-rebuild -f -w better-sqlite3",
    "start": "electron .",
    "dist:mac": "npm run bundle && electron-builder --mac",
    "bundle": "node bundle.mjs",
    "dist:dir": "npm run bundle && electron-builder --dir",
    "release": "node release.mjs"
  },
  "dependencies": {
    "better-sqlite3": "12.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.1",
    "electron": "37.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "js.unify.desktop",
    "productName": "Unify.js",
    "files": [
      "main.mjs",
      "preload.cjs",
      "bundle/**"
    ],
    "extraMetadata": {
      "main": "main.mjs"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "publish": null,
    "afterPack": "./adhoc-sign.cjs"
  },
  "allowScripts": {
    "electron@37.2.0": true,
    "better-sqlite3": false,
    "electron-winstaller": false
  },
  "author": "Unify.js"
}
